# Copy to .env and fill in. .env is gitignored and must never be committed.
ANTHROPIC_API_KEY=sk-ant-...

# WhatsApp Business Cloud API — all four are required for the live thread.
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=

# App secret. Used to verify X-Hub-Signature-256 on every inbound webhook.
# Without this the endpoint accepts forged messages into a pipeline that
# books appointments — it is a trust boundary, not a formality.
WHATSAPP_APP_SECRET=

# Any value you choose; Meta echoes it back during the GET handshake.
WHATSAPP_WEBHOOK_VERIFY_TOKEN=

# Shared secret n8n sends in the X-N8N-Secret header when it polls
# GET /reminders/due and POST /reminders/sent (the 24-hour-ahead
# confirmation reminder hop). Any value you choose. Without this, both
# endpoints refuse every request -- a missing secret is closed, not
# open, not a way to leave them open during setup.
N8N_REMINDER_SECRET=
