        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ messaging_product: \"whatsapp\", to: $json.customer_phone, type: \"template\", template: { name: \"appointment_reminder_24h\", language: { code: \"en_GB\" }, components: [ { type: \"body\", parameters: [ { type: \"text\", text: $json.service_name }, { type: \"text\", text: $json.starts_at_label } ] } ] } }) }}",
        "options": {}
